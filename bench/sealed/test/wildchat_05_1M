TO @tablaCurp VALUES (1, '1');\n    INSERT INTO @tablaCurp VALUES (2, '2');\n    INSERT INTO @tablaCurp VALUES (3, '3');\n    INSERT INTO @tablaCurp VALUES (4, '4');\n    INSERT INTO @tablaCurp VALUES (5, '5');\n    INSERT INTO @tablaCurp VALUES (6, '6');\n    INSERT INTO @tablaCurp VALUES (7, '7');\n    INSERT INTO @tablaCurp VALUES (8, '8');\n    INSERT INTO @tablaCurp VALUES (9, '9');\n    INSERT INTO @tablaCurp VALUES (10, 'A');\n    INSERT INTO @tablaCurp VALUES (11, 'B');\n    INSERT INTO @tablaCurp VALUES (12, 'C');\n    INSERT INTO @tablaCurp VALUES (13, 'D');\n    INSERT INTO @tablaCurp VALUES (14, 'E');\n    INSERT INTO @tablaCurp VALUES (15, 'F');\n    INSERT INTO @tablaCurp VALUES (16, 'G');\n    INSERT INTO @tablaCurp VALUES (17, 'H');\n    INSERT INTO @tablaCurp VALUES (18, 'I');\n    INSERT INTO @tablaCurp VALUES (19, 'J');\n    INSERT INTO @tablaCurp VALUES (20, 'K');\n    INSERT INTO @tablaCurp VALUES (21, 'L');\n    INSERT INTO @tablaCurp VALUES (22, 'M');\n    INSERT INTO @tablaCurp VALUES (23, 'N');\n    INSERT INTO @tablaCurp VALUES (24, 'Ñ');\n    INSERT INTO @tablaCurp VALUES (25, 'O');\n    INSERT INTO @tablaCurp VALUES (26, 'P');\n    INSERT INTO @tablaCurp VALUES (27, 'Q');\n    INSERT INTO @tablaCurp VALUES (28, 'R');\n    INSERT INTO @tablaCurp VALUES (29, 'S');\n    INSERT INTO @tablaCurp VALUES (30, 'T');\n    INSERT INTO @tablaCurp VALUES (31, 'U');\n    INSERT INTO @tablaCurp VALUES (32, 'V');\n    INSERT INTO @tablaCurp VALUES (33, 'W');\n    INSERT INTO @tablaCurp VALUES (34, 'X');\n    INSERT INTO @tablaCurp VALUES (35, 'Y');\n    INSERT INTO @tablaCurp VALUES (36, 'Z');\n\n    DECLARE @suma int = 0\n    DECLARE @factor int = 18\n\n    WHILE @factor > 1 BEGIN\n        SELECT @suma = @suma + (SELECT digito FROM @tablaCurp WHERE letra = SUBSTRING(@curpHomoclave, @factor, 1)) * @factor\n        SELECT @factor = @factor - 1\n    END\n\n    SELECT @curpHomoclave = @curpHomoclave + (SELECT letra FROM @tablaCurp WHERE digito = (11 - (@sum